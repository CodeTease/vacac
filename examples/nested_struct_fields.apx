// Compose structs with nested records and fixed-size primitive arrays.
struct Profile {
    name: str,
    scores: [i64; 3],
}

struct TeamMember {
    profile: Profile,
    active: bool,
}

fn main() -> i64 {
    let member = TeamMember {
        profile: Profile { name: "Ada", scores: [8, 6, 9] },
        active: true,
    };

    // Mutate through both a nested struct field and an array field.
    member.profile.scores[1] = member.profile.scores[1] + 3;

    print(member.profile.name);
    print("'s updated score: ");
    print_i64(member.profile.scores[1]);
    if member.active { 0 } else { 1 }
}