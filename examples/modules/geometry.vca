mod point;

use point::Direction;
use point::Point;

pub fn distance_squared() -> i64 {
    let origin = Point { x: 0, y: 0 };
    let endpoint = Point { x: 3, y: 4 };
    let direction = Direction::North;

    match direction {
        Direction::North => {
            let dx = endpoint.x - origin.x;
            let dy = endpoint.y - origin.y;
            dx * dx + dy * dy
        },
        Direction::South => { 0 },
    }
}
