// Skip 3, stop before 8, and add the remaining values from 1 through 7.
fn main() -> i64 {
    let total: i64 = 0;
    for value in 1..10 {
        if value == 3 {
            continue;
        }
        if value == 8 {
            break;
        }
        total = total + value;
    }

    print("total = ");
    print_i64(total);
    0
}