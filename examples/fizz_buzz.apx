// Print the classic FizzBuzz sequence from 1 through 30.
fn main() -> i64 {
    for number in 1..31 {
        if number % 15 == 0 {
            println("FizzBuzz");
        } else {
            if number % 3 == 0 {
                println("Fizz");
            } else {
                if number % 5 == 0 {
                    println("Buzz");
                } else {
                    print_i64(number);
                }
            }
        }
    }
    0
}